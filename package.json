{
  "name": "mantis-cr-search-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run preview\"",
    "electron": "electron electron/main.cjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mantis.crhub",
    "productName": "Mantis CR Ultra Hub",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "data/cr_database.json",
      "data/cr_meta.json",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**",
      "dist/**"
    ],
    "mac": {
      "target": ["dmg"],
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "title": "Mantis CR Ultra Hub",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mantis CR Ultra Hub",
      "artifactName": "MantisCRHub-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/diff": "^7.0.2",
    "@types/ssh2": "^1.15.5",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "diff": "^9.0.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
